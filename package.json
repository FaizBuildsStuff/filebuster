{
  "name": "file-buster",
  "version": "1.0.0",
  "description": "Windows desktop app that gamifies file deletion with realistic 2D cartoon visual animations",
  "main": "src/main/index.js",
  "author": "cryptovoidex",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "register-menu": "node -e \"require('./src/main/context-menu').registerContextMenu()\"",
    "unregister-menu": "node -e \"require('./src/main/context-menu').unregisterContextMenu()\"",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.cryptovoidex.filebuster",
    "productName": "File Buster",
    "copyright": "Copyright © 2026 cryptovoidex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/tracker.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "File Buster",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "uninstallDisplayName": "File Buster",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "electron",
    "windows",
    "file-buster",
    "animation",
    "gamification"
  ],
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  }
}
